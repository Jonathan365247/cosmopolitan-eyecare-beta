# Stable beta default. A production launch must explicitly set both values in
# Vercel after the final canonical domain and indexability have been approved.
NEXT_PUBLIC_SITE_MODE=beta
NEXT_PUBLIC_SITE_URL=https://cosmopolitan-eyecare-beta.vercel.app

# Optional: enables the approved AccessiYes accessibility-preferences widget.
# Get this unique ID from https://www.accessiyes.com/get-your-script
NEXT_PUBLIC_ACCESSIYES_WIDGET_ID=

# Sanity Content Studio. These are added automatically by the Vercel Marketplace
# integration; never commit the server-only read or write tokens.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
